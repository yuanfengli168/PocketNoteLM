<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pocketnotelm.frontend</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <!-- install.sh copies start-frontend.sh here and sets the correct path -->
        <string>/Users/REPLACE_WITH_YOUR_USERNAME/pocketnotelm-start-frontend.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/pocketnotelm-frontend.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/pocketnotelm-frontend-error.log</string>
</dict>
</plist>
